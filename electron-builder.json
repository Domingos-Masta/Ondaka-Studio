{
  "asar": true,
  "fileAssociations": [
    {
      "ext": "swproj",
      "name": "Ondaka Studio Project",
      "description": "Ondaka Studio project",
      "role": "Editor"
    }
  ],
  "directories": {
    "output": "release/"
  },
  "files": [
    "**/*",
    "!**/*.ts",
    "!*.map",
    "!package.json",
    "!package-lock.json",
    {
      "from": "../dist",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "build/icons/ondaka-icon.png",
    "target": [
      "portable"
    ]
  },
  "portable": {
    "splashImage": "dist/browser/assets/icons/electron.bmp"
  },
  "mac": {
    "icon": "build/icons/ondaka-icon.icns",
    "target": [
      "dmg"
    ]
  },
  "linux": {
    "icon": "build/icons/ondaka-icon.png",
    "target": [
      "AppImage",
      {
        "target": "flatpak",
        "arch": ["x64"]
      }
    ]
  },
  "flatpak": {
    "category": "Utility",
    "base": "org.electronjs.Electron2.BaseApp",
    "baseVersion": "25.08",
    "runtime": "org.freedesktop.Platform",
    "runtimeVersion": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "finishArgs": [
      "--socket=wayland",
      "--socket=x11",
      "--share=ipc",
      "--device=dri",
      "--socket=pulseaudio",
      "--filesystem=home",
      "--share=network",
      "--talk-name=org.freedesktop.Notifications"
    ]
  }
}
